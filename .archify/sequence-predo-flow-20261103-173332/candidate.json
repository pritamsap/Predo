  "cards": [
    {
      "dot": "cyan",
      "title": "Dev vs production",
      "items": [
        "Dev: Vite serves React on :5173 and proxies /api to Express on :3001",
        "Production: npm run build makes frontend/dist, and Express serves it plus /api on one port",
        "Same fetch('/api/...') code works in both, so no CORS setup"
      ]
    },
    {
      "dot": "emerald",
      "title": "The one pattern to learn",
      "items": [
        "Every action is: React calls fetch, Express changes todos.json, React updates state",
        "State update re-renders the list; the server is the source of truth",
        "Use setTodos(prev => ...) so fast clicks never overwrite each other"
      ]
    },
    {
      "dot": "amber",
      "title": "Where to read the code",
      "items": [
        "frontend/src/App.jsx: the whole UI and all four fetch calls",
        "backend/server.js: four routes plus readTodos and saveTodos",
        "backend/todos.json: created on the first add"
      ]
    }
  ]
